# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faultlens?schema=public

# Redis Configuration (BullMQ & Caching)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=faultlens_super_secret_jwt_key_development_2026_secure
JWT_EXPIRES_IN=7d

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Monitoring & Anomaly Detection Tuning
ANOMALY_SENSITIVITY=3.0
CORRELATION_WINDOW_MINUTES=60
RAW_TELEMETRY_RETENTION_DAYS=7
